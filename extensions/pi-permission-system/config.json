{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/pi-github-repos": "allow",
      "/tmp/pi-github-repos/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "find": {
      "*": "allow"
    },
    "ls": {
      "*": "allow"
    },
    "write": {
      "*": "ask",
      "*.lock": "deny"
    },
    "edit": {
      "*": "ask",
      "*.lock": "deny"
    },
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "cksum *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "date": "allow",
      "uptime": "allow",
      "which *": "allow",
      "type *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "git rev-parse *": "allow",
      "git describe *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git tag --list *": "allow",
      "rm -rf *": "ask",
      "sudo *": "ask"
    },
    "fffind": "allow",
    "ffgrep": "allow",
    "web_search": "allow",
    "fetch_content": "allow",
    "get_search_content": "allow",
    "ctx_stats": "allow",
    "ctx_doctor": "allow",
    "ctx_search": "allow",
    "ask_user_question": "allow",
    "third_party_tool": "ask",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": {
      "*": "ask",
      "librarian": "allow",
      "context-mode": "allow",
      "ctx-*": "allow"
    }
  }
}
